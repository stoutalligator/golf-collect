{
  "name": "greens-keeper",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/ui": "~58.0.29",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "puppeteer-core": "^24.43.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/vitest.mjs run",
    "art:prompts": "node scripts/art/art.mjs prompts",
    "art:sync": "node scripts/art/art.mjs sync",
    "screens": "node scripts/screens.mjs",
    "art:specs": "node scripts/art/art.mjs prompts && python scripts/art/gen-specs.py",
    "db:import-courses": "node --env-file=.env scripts/db/import-courses.ts",
    "db:seed-test": "node --env-file=.env --import ./scripts/db/register.mjs scripts/db/seed-test-accounts.ts",
    "lock:fix": "npx -y npm@10.9 install --package-lock-only --no-audit --no-fund"
  },
  "private": true,
  "optionalDependencies": {
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2"
  }
}
